{
	"manifest_version": 3,
	"name": "HTML Multi-Page Accumulator for AI",
	"version": "1.0.0",
	"author": "normonds & Gemini 3.8 Flash (Medium)",
	"description": "Accumulates rendered HTML body across multiple paginated pages into a single file or clipboard payload for AI analysis.",
	"permissions": [
		"activeTab",
		"scripting",
		"storage",
		"unlimitedStorage",
		"clipboardWrite"
	],
	"content_scripts": [
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"content.js"
			],
			"css": [
				"styles.css"
			],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		},
		"default_title": "Multi-Page HTML Accumulator"
	},
	"background": {
		"service_worker": "background.js"
	},
	"commands": {
		"capture-page": {
			"suggested_key": {
				"default": "Alt+Shift+C",
				"mac": "Command+Shift+C"
			},
			"description": "Capture and append current page"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "html-accumulator-ai@local.addon",
			"strict_min_version": "109.0"
		}
	}
}
